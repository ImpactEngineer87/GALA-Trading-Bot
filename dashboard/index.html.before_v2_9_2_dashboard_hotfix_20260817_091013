function maybeNotifySchwabAuthExpired(status){
  if(!status || !status.auth_expired || !status.verified) {
    if(status && status.connected) {
      lastSchwabAuthAlertAt = 0;
      try { localStorage.removeItem(SCHWAB_AUTH_ALERT_STORAGE_KEY); } catch(e) {}
    }
    return;
  }
  const now = Date.now();
  let storedAt = 0;
  try {
    storedAt = Number(localStorage.getItem(SCHWAB_AUTH_ALERT_STORAGE_KEY) || 0);
  } catch(e) {}
  const previousAt = Math.max(lastSchwabAuthAlertAt, storedAt);
  const serverInterval = Number(status.notification_interval_seconds || 300) * 1000;
  const interval = Math.max(SCHWAB_AUTH_ALERT_INTERVAL_MS, serverInterval);
  if(now - previousAt < interval) return;

  // Record before rendering so simultaneous status callbacks cannot duplicate it.
  lastSchwabAuthAlertAt = now;
  try { localStorage.setItem(SCHWAB_AUTH_ALERT_STORAGE_KEY, String(now)); } catch(e) {}
  toast(
    'err',
    'Autorización Schwab expirada',
    status.message || 'Vuelve a autorizar Schwab en los pasos 1–3 del dashboard.'
  );
}

function updateSchwabAuthBanner(status){
  const banner = el('schwabAuthBanner');
  if(!banner) return;
  const confirmedExpired = Boolean(status && status.auth_expired && status.verified);
  banner.hidden = !confirmedExpired;
  if(confirmedExpired) {
    el('schwabAuthBannerMessage').textContent = status.message ||
      'Schwab rechazó la autorización. Vuelve a autorizarla para reanudar la conexión.';
  }
}

