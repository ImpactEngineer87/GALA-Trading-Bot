function chartSessionBounds(data=S.chartData){
  if(!data || !(data.candles||[]).length) return null;
  const candles=data.candles;
  let start=Number(data.session_start_epoch_ms || candles[0].epoch_ms);
  let end=Number(data.session_end_epoch_ms || candles[candles.length-1].epoch_ms);
  if(!Number.isFinite(start) || !Number.isFinite(end) || end<=start) return null;
  return {start,end};
}

function clampChartViewport(start,end){
  const bounds=chartSessionBounds();
  if(!bounds) return {start,end};
  const fullSpan=bounds.end-bounds.start;
  let span=Math.max(5*60000,Math.min(fullSpan,Number(end)-Number(start)));
  let nextStart=Number(start), nextEnd=nextStart+span;
  if(nextStart<bounds.start){nextStart=bounds.start;nextEnd=nextStart+span;}
  if(nextEnd>bounds.end){nextEnd=bounds.end;nextStart=nextEnd-span;}
  return {start:nextStart,end:nextEnd};
}

function chartAnchorEpoch(){
  const selected=S.chartData && S.chartData.selected_signal;
  const selectedEpoch=selected && Number(selected.epoch_ms || Date.parse(selected.timestamp_iso||''));
  if(Number.isFinite(selectedEpoch)) return selectedEpoch;
  const candles=(S.chartData && S.chartData.candles)||[];
  if(S.chartMode==='live' && candles.length) return Number(candles[candles.length-1].epoch_ms);
  if(Number.isFinite(S.chartViewportStart) && Number.isFinite(S.chartViewportEnd)){
    return (S.chartViewportStart+S.chartViewportEnd)/2;
  }
  const bounds=chartSessionBounds();
  return bounds ? (bounds.start+bounds.end)/2 : Date.now();
}

function setChartWindow(minutes,button){
  const value=Math.max(5,Number(minutes||60));
  S.chartWindow=value;
  S.chartFullSession=false;
  S.chartAutoFollow=S.chartMode==='live';
  if(!S.chartData){
    updateChartControls();
    if(S.selectedTicker) fetchSignalChart();
    return;
  }
  const anchor=chartAnchorEpoch();
  const span=value*60000;
  let start,end;
  if(S.chartMode==='live'){
    end=anchor;
    start=end-span;
  }else{
    start=anchor-span/2;
    end=anchor+span/2;
  }
  const clamped=clampChartViewport(start,end);
  S.chartViewportStart=clamped.start;
  S.chartViewportEnd=clamped.end;
  updateChartControls();
  drawSignalChart();
}

function showFullChartSession(button){
