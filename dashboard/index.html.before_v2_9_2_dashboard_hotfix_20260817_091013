    const ok = state === 'connected';
    const dotState = ok ? 'ok' : (state === 'unavailable' || state === 'unknown' ? 'warn' : 'err');
    ['schwabDot','schwabDot2'].forEach(id => {
      const dot = el(id);
      if(dot){ dot.className='schwab-dot '+dotState; }
    });
    el('schwabLabel').textContent = ok ? 'Schwab ✓' : (state === 'expired' ? 'Schwab expirada' : 'Schwab ✗');
    el('schwabStatusText').textContent = ok
      ? '✅ Conectado y verificado'
      : (state === 'expired' ? '⚠️ Autorización expirada' : (state === 'unavailable' ? '⚠️ Verificación no disponible' : '❌ Sin conectar'));
    el('schwabAccountText').textContent = state === 'expired'
      ? 'Vuelve a autorizar en los pasos 1–3 de abajo'
      : (d.account_number ? 'Cuenta: '+d.account_number : (d.message || 'Autoriza en el paso 1-3 de abajo'));
