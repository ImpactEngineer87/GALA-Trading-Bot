function aiRowForTicker(ticker){
  const t = String(ticker||'').toUpperCase();
  return (S.aiStatus || []).find(row => String(row.ticker||'').toUpperCase() === t) || null;
}

function renderTickerExecution(){
  const body = el('tickerExecutionRows');
  if(!body) return;
  const meta = S.tickerExecutionMeta || {};
  const running = !!(meta.bot_running || S.botRunning);
  const maxReal = Number(meta.max_real_tickers || 2);
  const maxRealShares = Number(meta.max_real_shares || 1);
  const realCount = (S.tickerExecution || []).filter(row => String(row.mode).toUpperCase()==='REAL').length;
  const paperCount = Math.max(0, (S.tickerExecution||[]).length - realCount);
  const summary = el('tickerExecutionSummary');
  const side = el('modePill');
  const cfgPill = el('cfgModePill');
  const summaryText = `${realCount} REAL · ${paperCount} PAPER · máx. REAL ${maxReal}`;
  if(summary){
    summary.textContent = summaryText;
    summary.className = 'pill ' + (realCount ? 'real' : 'paper');
  }
  if(side){
    side.textContent = realCount ? `🔴 ${realCount} REAL · ${paperCount} PAPER` : `📄 ${paperCount} PAPER`;
    side.className = 'pill ' + (realCount ? 'real' : 'paper');
  }
  if(cfgPill){
    cfgPill.textContent = realCount ? `${realCount} REAL` : 'POR TICKER';
    cfgPill.className = 'pill ' + (realCount ? 'real' : 'paper');
  }

  body.innerHTML = (S.tickerExecution || []).map(row => {
    const ticker = String(row.ticker||'').toUpperCase();
    const mode = String(row.mode||'PAPER').toUpperCase();
    const shares = Math.max(1, Number(row.shares||1));
    const ai = aiRowForTicker(ticker);
    const progress = ai ? `${Number(ai.new_observations||0)}/${Number(ai.retrain_samples||50)}` : '—';
    const production = !!(ai && ai.production_model_loaded);
    const modelText = production ? '✅ PRODUCTION' : (mode==='REAL' ? '⛔ NO PRODUCTION' : '—');
    const realDisabled = row.real_allowed === false ? 'disabled' : '';
    const controlsDisabled = running ? 'disabled' : '';
    const shareMax = mode === 'REAL' ? Number(row.max_real_shares || maxRealShares || 1) : maxPaperShares;
    return `<tr>
      <td class="notranslate" translate="no"><strong translate="no">${escHtml(ticker)}</strong></td>
      <td><span style="font-family:var(--mono)">${progress}</span></td>
      <td>
        <select class="exec-mode-select" id="exec-mode-${escHtml(ticker)}" ${controlsDisabled} onchange="updateExecShareLimit('${escHtml(ticker)}')">
          <option value="PAPER" ${mode==='PAPER'?'selected':''}>PAPER</option>
          <option value="REAL" ${mode==='REAL'?'selected':''} ${realDisabled}>REAL</option>
        </select>
        <span class="exec-badge ${mode}">${mode}</span>
      </td>
      <td><input class="exec-shares-input" id="exec-shares-${escHtml(ticker)}" type="number" min="1" max="${shareMax}" value="${shares}" ${controlsDisabled}></td>
      <td>${modelText}</td>
      <td><button class="btn btn-blue btn-sm" onclick="applyTickerExecution('${escHtml(ticker)}')" ${controlsDisabled}>Aplicar</button></td>
    </tr>`;
  }).join('') || '<tr><td colspan="6">Sin tickers configurados</td></tr>';
}

function updateExecShareLimit(ticker){
  const mode = el('exec-mode-'+ticker);
  const shares = el('exec-shares-'+ticker);
  if(!mode || !shares) return;
  const meta = S.tickerExecutionMeta || {};
  if(mode.value === 'REAL'){
    shares.max = Number(meta.max_real_shares || 1);
    if(Number(shares.value) > Number(shares.max)) shares.value = shares.max;
  } else {
    shares.max = Number(meta.max_paper_shares || 1000);
    if(Number(shares.value) > Number(shares.max)) shares.value = shares.max;
  }
}

async function applyTickerExecution(ticker){
  if(S.botRunning){
    toast('err','Cambio bloqueado','Detenga el bot antes de cambiar PAPER/REAL o acciones.');
    return;
  }
  const modeEl = el('exec-mode-'+ticker);
  const sharesEl = el('exec-shares-'+ticker);
  if(!modeEl || !sharesEl) return;
  const mode = String(modeEl.value||'PAPER').toUpperCase();
  const shares = Math.max(1, parseInt(sharesEl.value||'1',10));
  const ai = aiRowForTicker(ticker);
  const progress = ai ? `${Number(ai.new_observations||0)}/${Number(ai.retrain_samples||50)}` : 'actual';
  if(mode === 'REAL'){
    const ok = confirm(
      `⚠️ Activar REAL para ${ticker} con ${shares} acción(es)?\n\n` +
      `Las órdenes de ${ticker} podrán viajar a Schwab.\n` +
      `El progreso IA ${progress} se conserva y NO se reinicia.\n` +
      `El arranque del motor repetirá el Live Guard y broker preflight.`
    );
    if(!ok){ fetchTickerExecution(); return; }
  }
  try {
    const r = await api('/api/ticker-execution/'+encodeURIComponent(ticker), {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({mode,shares})
    });
    const d = await r.json();
    if(!r.ok){
      toast('err','Cambio bloqueado',d.message || 'No se pudo actualizar el ticker');
      await fetchTickerExecution();
      return;
    }
    toast(mode==='REAL'?'err':'ok',`${ticker} → ${mode}`,d.message || 'Configuración guardada');
    await fetchTickerExecution();
    fetchStatus();
  } catch(e){
    toast('err','Error',String(e));
    fetchTickerExecution();
  }
}

