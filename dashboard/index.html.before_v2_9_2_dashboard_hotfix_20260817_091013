async function fetchTrades(){
  try {
    const r = await api('/api/trades');
    const d = await r.json();
    if(d.status === 'ok'){
      S.positions = d.positions || [];
      S.tradeEvents = d.events || d.trades || [];
      S.trades = S.tradeEvents;
      el('tr-open').textContent   = S.positions.length;
      el('tr-closed').textContent = d.closed_count || 0;
      const pnl = Number(d.pnl_total || 0);
      el('tr-pnl').textContent = '$'+pnl.toFixed(2);
      el('tr-pnl').style.color = pnl>=0 ? 'var(--green)':'var(--red)';
      renderPositions('livePositionsFeed', S.positions, false);
      renderPositions('dashTradesFeed', S.positions, true);
      renderTradeEvents('tradesFeed', S.tradeEvents.slice().reverse());
    }
  } catch(e){}
}

function money(v){
  const n = Number(v || 0);
  return '$' + n.toFixed(2);
}

function renderPositions(id, positions, compact=false){
  const feed = el(id);
  if(!feed) return;
  if(!positions.length){
    feed.innerHTML = '<div class="empty-state"><div class="es-icon">💹</div><div>Sin posiciones abiertas</div></div>';
    return;
  }
  feed.innerHTML = positions.map(p => {
    const status = String(p.status || 'OPEN').toUpperCase();
    const initial = Number(p.initial_quantity || 0);
    const remaining = Number(p.remaining_quantity || 0);
    const partialDone = Number(p.partial_quantity_executed || 0);
    const plannedPartial = Number(p.planned_partial_quantity || 0);
    const plannedRemaining = Number(p.planned_remaining_quantity || 0);
    const be = Boolean(p.breakeven_active);
    if(compact){
      return `<div class="trade-row">
        <span class="trade-status ${status}">${status==='PARTIAL'?'PARCIAL':status}</span>
        <span class="sig-badge ${escHtml(p.side||'BUY')}">${escHtml(p.side||'—')}</span>
        <span class="sig-ticker">${escHtml(p.ticker||'—')}</span>
        <span class="sig-price">Entrada ${money(p.entry_price)}</span>
        <span style="font-size:.75rem;color:var(--txt2)">${remaining}/${initial} acc</span>
        ${be?'<span class="sig-ia">BE activo</span>':''}
      </div>`;
    }
    return `<div class="position-card">
      <div class="position-head">
        <span class="trade-status ${status}">${status==='PARTIAL'?'PARCIAL 70/30':status}</span>
        <span class="sig-badge ${escHtml(p.side||'BUY')}">${escHtml(p.side||'—')}</span>
        <span class="sig-ticker">${escHtml(p.ticker||'—')}</span>
        ${be?'<span class="sig-ia">Break-Even activo</span>':''}
        <span class="position-mode">${escHtml(p.mode||'')} ${escHtml((p.opened_at||'').replace('T',' '))}</span>
      </div>
      <div class="position-grid">
        <div class="position-metric"><div class="pm-label">Cantidad inicial</div><div class="pm-value">${initial}</div></div>
        <div class="position-metric"><div class="pm-label">Cantidad restante</div><div class="pm-value">${remaining}</div></div>
        <div class="position-metric"><div class="pm-label">Entrada</div><div class="pm-value">${money(p.entry_price)}</div></div>
        <div class="position-metric"><div class="pm-label">Stop actual</div><div class="pm-value">${money(p.stop_current)}</div></div>
        <div class="position-metric"><div class="pm-label">Objetivo final</div><div class="pm-value">${money(p.final_target)}</div></div>
      </div>
      <div class="position-progress">
        <span>TP1: ${plannedPartial || '—'} acc @ ${money(p.tp1_price)}</span>
        <span>Parcial ejecutado: ${partialDone} acc</span>
        <span>Plan restante: ${plannedRemaining || '—'} acc</span>
        <span class="${be?'be-active':''}">Protección: ${be?'BREAK-EVEN':escHtml(p.protection_mode||'Stop inicial')}</span>
        <span>PnL realizado: ${money(p.realized_pnl)}</span>
      </div>
    </div>`;
  }).join('');
}

function renderTradeEvents(id, events){
  const feed = el(id);
  if(!feed) return;
  if(!events.length){
    feed.innerHTML = '<div class="empty-state"><div class="es-icon">📋</div><div>Sin eventos</div></div>';
    return;
  }
  const labels = {
    ENTRY: 'ENTRY', OPEN: 'ENTRY',
    TP1_70_PERCENT: 'TP1 70%', PARTIAL: 'TP1 70%',
    CLOSE: 'CIERRE', CLOSED: 'CIERRE'
  };
  feed.innerHTML = events.map(t => {
    const pnl = Number(t.pnl || 0);
    const rawEvent = String(t.evento || t.estado || 'EVENT');
    const label = labels[rawEvent] || rawEvent;
    const cssState = rawEvent==='OPEN'?'ENTRY':rawEvent;
    const showPnl = ['CLOSE','CLOSED','TP1_70_PERCENT','PARTIAL'].includes(rawEvent);
    return `<div class="trade-row">
      <span class="trade-status ${cssState}">${escHtml(label)}</span>
      <span class="sig-badge ${escHtml(t.tipo||'BUY')}">${escHtml(t.tipo||'—')}</span>
      <span class="sig-ticker">${escHtml(t.ticker||'—')}</span>
      <span class="sig-price">${money(t.precio)}</span>
      <span style="font-size:.75rem;color:var(--txt3)">${Number(t.acciones||0)} acc</span>
      ${showPnl ? `<span class="trade-pnl ${pnl>=0?'pos':'neg'}">${pnl>=0?'+':''}$${pnl.toFixed(2)}</span>` : ''}
      <span class="sig-time">${escHtml(t.timestamp||'')}</span>
    </div>`;
  }).join('');
}

// ─────────────────────────────────────────────────────────
// FETCH HISTORIAL (operaciones cerradas, persistente en disco)
// ─────────────────────────────────────────────────────────
async function fetchHistorial(){
  try {
    const r = await api('/api/historial');
    const d = await r.json();
    if(d.status !== 'ok'){ return; }
    const ops = d.operaciones || [];
    const closed = ops.filter(o => String(o.evento||'POSITION_CLOSE').toUpperCase()==='POSITION_CLOSE');
    let win=0, loss=0, pnl=0;
    closed.forEach(o => {
      pnl += parseFloat(o.pnl_usd||0);
      if((o.resultado||'')==='GANADA') win++;
      else if((o.resultado||'')==='PERDIDA') loss++;
    });
    el('h-total').textContent = d.total || closed.length;
    el('h-win').textContent   = win;
    el('h-loss').textContent  = loss;
    el('h-pnl').textContent   = '$'+pnl.toFixed(2);
    el('h-pnl').style.color   = pnl>=0 ? 'var(--green)':'var(--red)';
    const body = el('histBody');
    if(!ops.length){
      body.innerHTML = '<tr><td colspan="16"><div class="empty-state"><div class="es-icon">📒</div><div>Sin eventos de posición todavía.</div></div></td></tr>';
      return;
    }
    body.innerHTML = ops.map(o => {
      const p = parseFloat(o.pnl_usd||0);
      const isClose=String(o.evento||'POSITION_CLOSE').toUpperCase()==='POSITION_CLOSE';
      const rcls = (o.resultado||'')==='GANADA' ? 'hist-win' : ((o.resultado||'')==='PERDIDA'?'hist-loss':'');
      const state=`${o.state_before||'—'} → ${o.state_after||'—'}`;
      const entry=o.entrada===''?'—':'$'+parseFloat(o.entrada||0).toFixed(2);
      const exit=o.salida===''?'—':'$'+parseFloat(o.salida||0).toFixed(2);
      const pnlText=isClose?`${p>=0?'+':''}$${p.toFixed(2)}`:'—';
      const reversal=o.reversal_id||'';
      return `<tr>
        <td>${escHtml(o.fecha||'')}</td><td>${escHtml(o.hora_ny||'')}</td>
        <td><b>${escHtml(o.ticker||'')}</b></td><td>${escHtml(o.evento||'POSITION_CLOSE')}</td>
        <td>${escHtml(state)}</td><td>${escHtml(o.position_side||'—')}</td>
        <td>${escHtml(o.signal_side||'—')}</td><td>${escHtml(o.order_action||'—')}</td>
        <td>${entry}</td><td>${exit}</td><td>${escHtml(o.cantidad||'0')}</td>
        <td class="${isClose?(p>=0?'hist-win':'hist-loss'):''}">${pnlText}</td>
        <td class="${rcls}">${escHtml(o.resultado||'—')}</td>
        <td>${escHtml(o.motivo||'')}</td>
        <td title="${escHtml(reversal)}">${escHtml(reversal?reversal.slice(-12):'—')}</td>
        <td>${escHtml(o.modo||'')}</td>
      </tr>`;
    }).join('');
  } catch(e){}
}

async function fetchAuditoriaOrdenes(){
  try {
    const r = await api('/api/auditoria-ordenes?limit=500');
    const d = await r.json();
    if(d.status !== 'ok') return;
    const events = d.eventos || [];
    el('audit-total').textContent = d.total_mostrado || events.length;
    const body = el('auditBody');
    if(!events.length){
      body.innerHTML = '<tr><td colspan="16"><div class="empty-state"><div class="es-icon">🔎</div><div>Sin eventos de órdenes todavía.</div></div></td></tr>';
      return;
    }
    body.innerHTML = events.map(e => {
