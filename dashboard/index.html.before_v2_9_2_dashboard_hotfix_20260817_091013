}

function zoomSignalChart(factor,pivotFraction=.5){
  if(!S.chartData || !Number.isFinite(S.chartViewportStart) || !Number.isFinite(S.chartViewportEnd)) return;
  const oldSpan=S.chartViewportEnd-S.chartViewportStart;
  const pivot=Math.max(0,Math.min(1,Number(pivotFraction)));
  const pivotTime=S.chartViewportStart+oldSpan*pivot;
  const newSpan=oldSpan*Math.max(.2,Math.min(5,Number(factor||1)));
  const clamped=clampChartViewport(
    pivotTime-newSpan*pivot,
    pivotTime+newSpan*(1-pivot)
  );
  S.chartViewportStart=clamped.start;
  S.chartViewportEnd=clamped.end;
  S.chartWindow=Math.round((clamped.end-clamped.start)/60000);
  S.chartFullSession=false;
  S.chartAutoFollow=false;
  updateChartControls();
  drawSignalChart();
}

function resetSignalChartViewport(){
