<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GALA10 Chocoletra — Panel de Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ── TOKENS ───────────────────────────────────────── */
    :root {
      --bg:       #07090f;
      --bg2:      #0d1117;
      --bg3:      #131c2e;
      --bg4:      #1a2540;
      --border:   #1e2d4a;
      --blue:     #3b82f6;
      --green:    #10b981;
      --red:      #ef4444;
      --orange:   #f59e0b;
      --purple:   #8b5cf6;
      --txt1:     #e2e8f0;
      --txt2:     #94a3b8;
      --txt3:     #475569;
      --r-sm:     6px;  --r-md: 10px;
      --r-lg:     16px; --r-xl: 24px;
      --mono: 'JetBrains Mono', monospace;
      --t: 0.2s cubic-bezier(.4,0,.2,1);
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{font-size:14px;scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--txt1);min-height:100vh;overflow-x:hidden}
    a{color:inherit;text-decoration:none}
    button{cursor:pointer;font-family:inherit}
    input,select,textarea{font-family:inherit}

    /* ── SCROLLBAR ────────────────────────────────────── */
    ::-webkit-scrollbar{width:5px;height:5px}
    ::-webkit-scrollbar-track{background:transparent}
    ::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:99px}

    /* ── LOGIN OVERLAY ────────────────────────────────── */
    #loginOverlay{
      position:fixed;inset:0;background:var(--bg);
      z-index:9999;display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      transition:opacity .4s ease;
    }
    .login-card{
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-xl);padding:44px 40px;
      width:min(420px,92vw);text-align:center;
      box-shadow:0 20px 60px rgba(0,0,0,.6);
    }
    .login-logo{font-size:3rem;margin-bottom:12px}
    .login-title{font-size:1.5rem;font-weight:800;margin-bottom:6px}
    .login-sub{color:var(--txt2);font-size:.85rem;margin-bottom:28px}
    .login-field{
      width:100%;background:var(--bg2);border:1px solid var(--border);
      color:var(--txt1);padding:12px 16px;border-radius:var(--r-md);
      font-size:.95rem;margin-bottom:12px;outline:none;transition:border-color var(--t);
    }
    .login-field:focus{border-color:var(--blue)}
    .login-btn{
      width:100%;background:var(--blue);color:#fff;border:none;
      padding:13px;border-radius:var(--r-md);font-size:1rem;
      font-weight:700;letter-spacing:.02em;transition:filter var(--t);margin-top:4px;
    }
    .login-btn:hover{filter:brightness(1.12)}
    .login-error{
      color:var(--red);font-size:.82rem;margin-top:10px;
      min-height:18px;font-weight:500;
    }

    /* ── NAVBAR ───────────────────────────────────────── */
    .navbar{
      position:sticky;top:0;z-index:100;
      height:60px;background:rgba(7,9,15,.92);
      backdrop-filter:blur(12px);
      border-bottom:1px solid var(--border);
      display:flex;align-items:center;
      padding:0 20px;gap:16px;
    }
    .brand{display:flex;align-items:center;gap:10px;flex-shrink:0}
    .brand-icon{font-size:1.4rem}
    .brand-name{font-weight:800;font-size:1rem;white-space:nowrap}
    .brand-ver{font-size:.68rem;color:var(--txt3);font-weight:500;margin-top:2px;white-space:nowrap}
    .hamburger{
      display:none;flex-direction:column;gap:5px;
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-sm);padding:9px;flex-shrink:0;
    }
    .hamburger span{display:block;width:18px;height:2px;background:var(--txt2);border-radius:2px;transition:var(--t)}
    .nav-tabs{display:flex;gap:4px;flex:1;justify-content:center}
    .nav-tab{
      background:none;border:none;color:var(--txt2);
      padding:7px 14px;border-radius:var(--r-sm);
      font-size:.82rem;font-weight:600;white-space:nowrap;
      transition:all var(--t);
    }
    .nav-tab:hover{background:var(--bg3);color:var(--txt1)}
    .nav-tab.active{background:var(--bg4);color:var(--blue);box-shadow:inset 0 0 0 1px var(--border)}
    .navbar-right{display:flex;align-items:center;gap:14px;flex-shrink:0}
    .clock{font-family:var(--mono);font-size:.78rem;color:var(--txt3)}
    .bot-toggle{display:flex;align-items:center;gap:8px}
    .bot-status{font-size:.72rem;font-weight:700;letter-spacing:.05em;min-width:60px;text-align:right}
    .bot-status.on{color:var(--green)}
    .bot-status.off{color:var(--txt3)}
    .toggle-sw{position:relative;width:44px;height:24px;flex-shrink:0}
    .toggle-sw input{opacity:0;width:0;height:0}
    .toggle-track{
      position:absolute;inset:0;background:var(--bg4);
      border-radius:99px;transition:var(--t);border:1px solid var(--border);
    }
    .toggle-track::after{
      content:'';position:absolute;top:3px;left:3px;
      width:16px;height:16px;background:var(--txt3);
      border-radius:50%;transition:var(--t);
    }
    .toggle-sw input:checked + .toggle-track{background:rgba(16,185,129,.2);border-color:var(--green)}
    .toggle-sw input:checked + .toggle-track::after{background:var(--green);transform:translateX(20px)}
    .user-pill{
      display:flex;align-items:center;gap:6px;
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-sm);padding:5px 10px;font-size:.76rem;
      color:var(--txt2);cursor:pointer;transition:var(--t);
    }
    .user-pill:hover{border-color:var(--red);color:var(--red)}
    .schwab-dot{
      width:8px;height:8px;border-radius:50%;
      background:var(--txt3);flex-shrink:0;transition:var(--t);
    }
    .schwab-dot.ok{background:var(--green);box-shadow:0 0 6px var(--green)}
    .schwab-dot.err{background:var(--red);box-shadow:0 0 6px var(--red)}
    .schwab-dot.warn{background:var(--orange);box-shadow:0 0 6px var(--orange)}

    /* ── LAYOUT ───────────────────────────────────────── */
    .layout{display:grid;grid-template-columns:220px 1fr;height:calc(100vh - 60px)}
    .sidebar{
      background:var(--bg2);border-right:1px solid var(--border);
      padding:16px 10px;overflow-y:auto;
    }
    .sidebar-section{margin-bottom:20px}
    .sidebar-label{
      font-size:.65rem;font-weight:700;letter-spacing:.08em;
      color:var(--txt3);text-transform:uppercase;
      padding:0 8px;margin-bottom:6px;
    }
    .sidebar-item{
      display:flex;align-items:center;gap:10px;
      padding:9px 10px;border-radius:var(--r-sm);
      font-size:.82rem;font-weight:500;color:var(--txt2);
      cursor:pointer;transition:all var(--t);border:none;background:none;
      width:100%;text-align:left;
    }
    .sidebar-item:hover{background:var(--bg3);color:var(--txt1)}
    .sidebar-item.active{background:rgba(59,130,246,.12);color:var(--blue)}
    .sidebar-sep{height:1px;background:var(--border);margin:8px 0}
    .ticker-pill{
      display:flex;align-items:center;justify-content:space-between;
      padding:7px 10px;background:var(--bg3);border-radius:var(--r-sm);
      margin-bottom:4px;font-size:.78rem;font-weight:600;cursor:pointer;
      border:1px solid transparent;transition:all var(--t);
    }
    .ticker-pill:hover,.ticker-pill:focus{border-color:var(--blue);outline:none;color:var(--blue)}
    .ticker-pill.selected{border-color:var(--blue);background:rgba(59,130,246,.12)}
    .ticker-sig{font-size:.65rem;padding:2px 6px;border-radius:4px;background:var(--bg4);color:var(--txt3)}
    .ticker-sig.buy{background:rgba(16,185,129,.15);color:var(--green)}
    .ticker-sig.sell{background:rgba(239,68,68,.15);color:var(--red)}
    .ticker-rm{background:none;border:none;color:var(--txt3);font-size:1rem;line-height:1;cursor:pointer;transition:color var(--t)}
    .ticker-rm:hover{color:var(--red)}
    .ticker-add{display:flex;gap:6px;margin-top:6px}
    .ticker-input{
      flex:1;background:var(--bg3);border:1px solid var(--border);
      color:var(--txt1);padding:7px 10px;border-radius:var(--r-sm);
      font-size:.78rem;font-family:var(--mono);outline:none;
      text-transform:uppercase;
    }
    .ticker-input:focus{border-color:var(--blue)}
    .ticker-add-btn{
      background:var(--blue);color:#fff;border:none;
      padding:7px 10px;border-radius:var(--r-sm);font-size:.78rem;font-weight:700;
    }

    /* ── MAIN CONTENT ─────────────────────────────────── */
    .main{overflow-y:auto;padding:20px 22px;background:var(--bg)}
    .page{display:none}
    .page.active{display:block}
    .page-title{font-size:1.15rem;font-weight:800;margin-bottom:4px}
    .page-sub{color:var(--txt2);font-size:.8rem;margin-bottom:20px}

    /* ── CARDS ────────────────────────────────────────── */
    .card{
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-lg);padding:18px;
    }
    .card-title{font-size:.78rem;font-weight:700;color:var(--txt2);
      text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px}
    .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
    .stat-card{
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-lg);padding:16px;position:relative;overflow:hidden;
    }
    .stat-card::before{
      content:'';position:absolute;top:0;left:0;right:0;height:2px;
      background:var(--accent-color,var(--blue));
    }
    .stat-icon{font-size:1.3rem;margin-bottom:8px}
    .stat-value{font-size:1.7rem;font-weight:800;font-family:var(--mono);line-height:1}
    .stat-label{font-size:.7rem;color:var(--txt2);margin-top:4px;font-weight:500}
    .stat-card.green{--accent-color:var(--green)}
    .stat-card.red{--accent-color:var(--red)}
    .stat-card.orange{--accent-color:var(--orange)}
    .stat-card.purple{--accent-color:var(--purple)}
    .daily-risk-card{
      display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:14px;
      align-items:center;margin-bottom:16px;padding:14px 18px;
    }
    .daily-risk-card.blocked{border-color:rgba(239,68,68,.65);background:rgba(239,68,68,.07)}
    .daily-risk-title{font-size:.8rem;font-weight:800;letter-spacing:.03em}
    .daily-risk-sub{font-size:.68rem;color:var(--txt3);margin-top:3px}
    .daily-risk-metric{border-left:1px solid var(--border);padding-left:14px}
    .daily-risk-value{font-family:var(--mono);font-size:1rem;font-weight:800}
    .daily-risk-label{font-size:.65rem;color:var(--txt3);margin-top:3px}
    @media(max-width:900px){.daily-risk-card{grid-template-columns:1fr 1fr}.daily-risk-metric{border-left:none;padding-left:0}}

    /* ── SIGNAL ROWS ──────────────────────────────────── */
    .signal-feed{display:flex;flex-direction:column;gap:6px}
    .signal-row{
      display:flex;align-items:center;gap:10px;
      background:var(--bg2);border:1px solid var(--border);
      border-radius:var(--r-md);padding:10px 14px;
      animation:slideIn .3s ease;
    }
    .signal-row.clickable{cursor:pointer;transition:border-color var(--t),transform var(--t)}
    .signal-row.clickable:hover,.signal-row.clickable:focus{border-color:var(--blue);transform:translateY(-1px);outline:none}
    @keyframes slideIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
    .sig-badge{
      padding:3px 8px;border-radius:5px;font-size:.7rem;
      font-weight:800;letter-spacing:.04em;flex-shrink:0;font-family:var(--mono);
    }
    .sig-badge.BUY{background:rgba(16,185,129,.15);color:var(--green);border:1px solid rgba(16,185,129,.3)}
    .sig-badge.SELL{background:rgba(239,68,68,.15);color:var(--red);border:1px solid rgba(239,68,68,.3)}
    .sig-badge.OM-R,.sig-badge.OM-T{background:rgba(71,85,105,.2);color:var(--txt3);border:1px solid var(--border)}
    .sig-ticker{font-weight:700;font-size:.85rem;min-width:44px;font-family:var(--mono)}
    .sig-price{font-family:var(--mono);font-size:.83rem;color:var(--txt2)}
    .sig-ia{font-size:.7rem;padding:2px 8px;border-radius:4px;background:rgba(139,92,246,.15);color:var(--purple)}
    .sig-time{font-size:.7rem;color:var(--txt3);margin-left:auto;font-family:var(--mono);white-space:nowrap}
    .empty-state{
      text-align:center;padding:44px 20px;color:var(--txt3);
    }
    .empty-state .es-icon{font-size:2.5rem;margin-bottom:10px}

    /* ── SIGNAL HISTORY CHART ─────────────────────────── */
    .signal-chart-card{margin-bottom:16px}
    .signal-chart-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .signal-chart-title{font-size:.95rem;font-weight:800;font-family:var(--mono)}
    .signal-chart-meta{font-size:.72rem;color:var(--txt3);margin-top:4px}
    .chart-controls{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}
    .chart-date-control{display:flex;align-items:center;gap:6px;padding:4px 6px;border:1px solid var(--border);border-radius:var(--r-sm);background:var(--bg2)}
    .chart-date-control label{font-size:.69rem;color:var(--txt3);font-weight:700}
    .chart-date-control input{border:0;outline:0;background:transparent;color:var(--txt1);font-family:var(--mono);font-size:.73rem;color-scheme:dark;min-width:128px}
    .chart-date-control.active{border-color:var(--blue);background:rgba(59,130,246,.10)}
    .chart-date-control .active{border-color:var(--blue);color:var(--blue);background:rgba(59,130,246,.12)}
    .chart-window-buttons{display:flex;gap:6px}
    .chart-window-buttons .active{border-color:var(--blue);color:var(--blue);background:rgba(59,130,246,.12)}
    .chart-live-button.active{border-color:var(--green);color:var(--green);background:rgba(16,185,129,.12)}
    .chart-live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:4px;box-shadow:0 0 7px currentColor}
    .chart-zoom-buttons{display:flex;gap:4px;padding-left:2px}
    .chart-zoom-buttons .btn{min-width:30px;padding-left:8px;padding-right:8px;font-size:1rem;line-height:1}
    .signal-chart-wrap{margin-top:12px;min-height:300px;border:1px solid var(--border);border-radius:var(--r-md);background:var(--bg2);overflow:hidden;cursor:grab;touch-action:none;position:relative}
    .signal-chart-wrap.dragging{cursor:grabbing}
    .signal-chart-wrap svg{display:block;width:100%;height:auto;min-height:300px;user-select:none}
    .chart-live-badge{font-size:.68rem;font-weight:800;color:var(--green);letter-spacing:.04em}
    .chart-live-badge.stale{color:var(--orange)}
    .chart-help{margin-top:8px;font-size:.68rem;color:var(--txt3)}
    .chart-legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px;font-size:.7rem;color:var(--txt2)}
    .chart-legend span{display:inline-flex;align-items:center;gap:5px}
    .legend-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
    .position-pnl-positive{color:var(--green);font-weight:800}
    .position-pnl-negative{color:var(--red);font-weight:800}

    /* ── TRADE ROWS ───────────────────────────────────── */
    .trade-row{
      display:flex;align-items:center;gap:10px;
      background:var(--bg2);border:1px solid var(--border);
      border-radius:var(--r-md);padding:10px 14px;margin-bottom:6px;
      animation:slideIn .3s ease;
    }
    .trade-status{
      padding:3px 8px;border-radius:5px;font-size:.68rem;font-weight:800;
      letter-spacing:.04em;flex-shrink:0;font-family:var(--mono);
    }
    .trade-status.OPEN,.trade-status.ENTRY{background:rgba(59,130,246,.15);color:var(--blue);border:1px solid rgba(59,130,246,.3)}
    .trade-status.PARTIAL,.trade-status.TP1_70_PERCENT{background:rgba(245,158,11,.15);color:var(--orange);border:1px solid rgba(245,158,11,.3)}
    .trade-status.CLOSED,.trade-status.CLOSE{background:rgba(71,85,105,.2);color:var(--txt3);border:1px solid var(--border)}
    .trade-status.PENDING{background:rgba(139,92,246,.15);color:var(--purple);border:1px solid rgba(139,92,246,.3)}
    .trade-pnl.pos{color:var(--green);font-weight:700;font-family:var(--mono)}
    .trade-pnl.neg{color:var(--red);font-weight:700;font-family:var(--mono)}
    .position-card{
      background:var(--bg2);border:1px solid var(--border);border-radius:var(--r-md);
      padding:14px;margin-bottom:10px;animation:slideIn .3s ease;
    }
    .position-head{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
    .position-mode{margin-left:auto;font-size:.68rem;color:var(--txt3);font-family:var(--mono)}
    .position-grid{display:grid;grid-template-columns:repeat(5,minmax(105px,1fr));gap:8px}
    .position-metric{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:8px 10px}
    .position-metric .pm-label{font-size:.66rem;color:var(--txt3);margin-bottom:3px}
    .position-metric .pm-value{font-size:.82rem;font-weight:700;font-family:var(--mono);color:var(--txt1)}
    .position-progress{margin-top:10px;font-size:.72rem;color:var(--txt2);display:flex;gap:8px;flex-wrap:wrap}
    .position-progress span{padding:3px 7px;border:1px solid var(--border);border-radius:5px;background:var(--bg3)}
    .be-active{color:var(--green)!important;border-color:rgba(16,185,129,.35)!important;background:rgba(16,185,129,.10)!important}
    .section-note{font-size:.72rem;color:var(--txt3);margin:4px 0 10px;line-height:1.5}
    @media(max-width:900px){.position-grid{grid-template-columns:repeat(2,minmax(120px,1fr))}}
    @media(max-width:520px){.position-grid{grid-template-columns:1fr}.position-mode{margin-left:0;width:100%}}

    /* ── LOG ──────────────────────────────────────────── */
    .log-box{
      background:var(--bg2);border:1px solid var(--border);
      border-radius:var(--r-md);padding:12px;
      height:420px;overflow-y:auto;font-family:var(--mono);font-size:.72rem;
    }
    .log-line{padding:2px 0;border-bottom:1px solid rgba(30,45,74,.4);line-height:1.6}
    .log-line:last-child{border-bottom:none}
    .log-t{color:var(--txt3)}
    .log-lvl{font-weight:700;padding:0 4px}
    .log-lvl.INFO{color:var(--blue)}
    .log-lvl.WARN{color:var(--orange)}
    .log-lvl.ERROR{color:var(--red)}
    .log-lvl.BUY{color:var(--green)}
    .log-lvl.SELL{color:var(--red)}

    /* ── CONFIG ───────────────────────────────────────── */
    .config-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .config-card{
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-lg);padding:16px;
    }
    .config-card.highlight{border-color:var(--blue)}
    .config-card-title{
      font-size:.75rem;font-weight:700;color:var(--txt2);
      text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;
      display:flex;align-items:center;gap:6px;
    }
    .cfg-row{margin-bottom:12px}
    .cfg-label{font-size:.75rem;font-weight:600;color:var(--txt2);margin-bottom:5px}
    .cfg-hint{font-size:.67rem;color:var(--txt3);margin-top:2px}
    .cfg-input{
      width:100%;background:var(--bg2);border:1px solid var(--border);
      color:var(--txt1);padding:9px 12px;border-radius:var(--r-sm);
      font-size:.82rem;outline:none;transition:border-color var(--t);
    }
    .cfg-input:focus{border-color:var(--blue)}
    .cfg-input[type=password]{font-family:var(--mono)}
    .cfg-range{width:100%;accent-color:var(--blue);cursor:pointer;margin-top:2px}
    .cfg-val{font-family:var(--mono);font-size:.78rem;color:var(--blue);font-weight:700}
    .cfg-range-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}

    /* ── SCHWAB CONNECT CARD ──────────────────────────── */
    .schwab-card{
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-lg);padding:20px;margin-bottom:14px;
    }
    .schwab-status-row{
      display:flex;align-items:center;gap:10px;
      padding:12px;background:var(--bg2);border-radius:var(--r-md);margin-bottom:14px;
    }
    .schwab-steps{display:flex;flex-direction:column;gap:10px}
    .schwab-step{
      display:flex;gap:12px;align-items:flex-start;
      padding:12px;background:var(--bg2);border-radius:var(--r-md);
    }
    .step-num{
      width:24px;height:24px;border-radius:50%;
      background:var(--blue);color:#fff;font-size:.72rem;font-weight:800;
      display:flex;align-items:center;justify-content:center;flex-shrink:0;
    }
    .step-txt{font-size:.8rem;color:var(--txt2);line-height:1.5}
    .step-link{color:var(--blue);font-size:.75rem;word-break:break-all;font-family:var(--mono)}

    /* ── BUTTONS ──────────────────────────────────────── */
    .btn{
      display:inline-flex;align-items:center;gap:6px;
      padding:9px 16px;border-radius:var(--r-sm);border:none;
      font-size:.8rem;font-weight:700;transition:all var(--t);cursor:pointer;
    }
    .btn-blue{background:var(--blue);color:#fff}
    .btn-blue:hover{filter:brightness(1.1)}
    .btn-green{background:var(--green);color:#fff}
    .btn-green:hover{filter:brightness(1.1)}
    .btn-red{background:rgba(239,68,68,.15);color:var(--red);border:1px solid rgba(239,68,68,.3)}
    .btn-red:hover{background:var(--red);color:#fff}
    .btn-ghost{background:var(--bg3);color:var(--txt2);border:1px solid var(--border)}
    .btn-ghost:hover{border-color:var(--blue);color:var(--txt1)}
    .btn-full{width:100%;justify-content:center}
    .btn-sm{padding:6px 12px;font-size:.75rem}

    /* ── TOAST ────────────────────────────────────────── */
    #toastBox{
      position:fixed;bottom:20px;right:20px;z-index:9000;
      display:flex;flex-direction:column;gap:8px;pointer-events:none;
    }
    .toast{
      background:var(--bg3);border:1px solid var(--border);
      border-radius:var(--r-md);padding:12px 16px;
      display:flex;align-items:center;gap:10px;
      min-width:260px;max-width:360px;
      box-shadow:0 4px 20px rgba(0,0,0,.4);
      animation:toastIn .3s ease;pointer-events:all;
    }
    @keyframes toastIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}
    .toast.ok .toast-icon::after{content:'✅'}
    .toast.err .toast-icon::after{content:'❌'}
    .toast.info .toast-icon::after{content:'ℹ️'}
    .toast-title{font-size:.8rem;font-weight:700}
    .toast-msg{font-size:.73rem;color:var(--txt2);margin-top:2px}

    /* ── PERSISTENT SCHWAB AUTH ALERT ─────────────────── */
    .schwab-auth-banner{
      display:flex;align-items:center;justify-content:space-between;gap:14px;
      margin-bottom:16px;padding:13px 15px;border-radius:var(--r-md);
      border:1px solid rgba(239,68,68,.55);background:rgba(127,29,29,.28);
      color:#fee2e2;box-shadow:0 4px 18px rgba(0,0,0,.22);
    }
    .schwab-auth-banner[hidden]{display:none}
    .schwab-auth-banner-copy{display:flex;align-items:flex-start;gap:10px}
    .schwab-auth-banner-title{font-size:.82rem;font-weight:800}
    .schwab-auth-banner-msg{font-size:.73rem;color:#fecaca;margin-top:3px;line-height:1.45}

    /* ── BOTTOM NAV (mobile) ──────────────────────────── */
    .bottom-nav{display:none}

    /* ── TWO-COL ─────────────────────────────────────── */
    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px}

    /* ── PILL ────────────────────────────────────────── */
    .pill{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;
      border-radius:99px;font-size:.68rem;font-weight:700;letter-spacing:.03em}
    .pill.paper{background:rgba(245,158,11,.12);color:var(--orange);border:1px solid rgba(245,158,11,.3)}
    .pill.real{background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.3)}

    /* ── RESPONSIVE ───────────────────────────────────── */
    @media(max-width:1100px){
      .stats-row{grid-template-columns:repeat(2,1fr)}
      .config-grid{grid-template-columns:1fr}
      .two-col{grid-template-columns:1fr}
    }
    @media(max-width:768px){
      html{font-size:13px}
      .hamburger{display:flex}
      .nav-tabs{display:none}
      .clock{display:none}
      .layout{grid-template-columns:1fr}
      .sidebar{
        position:fixed;top:60px;left:0;height:calc(100vh - 60px);
        z-index:200;transform:translateX(-100%);
        transition:transform .3s ease;width:240px;
        box-shadow:4px 0 24px rgba(0,0,0,.5);
      }
      .sidebar.open{transform:translateX(0)}
      .sidebar-overlay{
        display:none;position:fixed;inset:0;z-index:199;
        background:rgba(0,0,0,.5);top:60px;
      }
      .sidebar-overlay.open{display:block}
      .main{padding:14px 12px;padding-bottom:72px}
      .stats-row{grid-template-columns:1fr 1fr;gap:8px}
      .bottom-nav{
        display:flex;position:fixed;bottom:0;left:0;right:0;
        height:64px;background:var(--bg2);border-top:1px solid var(--border);
        z-index:150;align-items:center;justify-content:space-around;
