    const risk = d.config.risk || {};
    const scheduler = d.config.scheduler || {};
    const live = d.config.live_trading || {};
    const daily = ((d.config.kill_switch || {}).daily_loss || {});
    const perTicker = !!live.per_ticker_execution;
    el('cfg_sizing_mode').value = risk.sizing_mode || 'atr';
    el('cfg_fixed_shares').value = risk.fixed_shares || 20;
    el('cfg_risk_pct').value = risk.risk_per_trade_pct || 1;
    el('cfg_sizing_mode').disabled = perTicker;
    el('cfg_fixed_shares').disabled = perTicker;
    el('cfg_risk_pct').disabled = perTicker;
    if(perTicker){
      el('cfg_sizing_mode').title = 'v2.9.2: la cantidad efectiva se define por ticker en el Dashboard';
      el('cfg_fixed_shares').title = 'v2.9.2: use Ejecución por Ticker';
      el('cfg_risk_pct').title = 'v2.9.2: use Ejecución por Ticker';
    }
    const slFactor=Number(risk.stop_loss_factor || 3.5);
    const tpFactor=Number(risk.take_profit_factor || 4.5);
    el('cfg_stop_loss_factor').value=String(Math.round(slFactor*10));
    el('cfg_take_profit_factor').value=String(Math.round(tpFactor*10));
    updateSlider('sl',Math.round(slFactor*10),'atr');
    updateSlider('tp',Math.round(tpFactor*10),'atr');
    const paperLimit = Math.abs(Number(daily.paper_limit_usd || 250));
    const liveLimit = Math.abs(Number(daily.live_limit_usd || 200));
    el('cfgDailyPaper').textContent = `PAPER -$${paperLimit.toFixed(0)}`;
    el('cfgDailyLive').textContent = `REAL -$${liveLimit.toFixed(0)}`;
    el('cfg_schedule_mode').value = scheduler.modo === 'automatico'
      ? 'automatico' : 'manual';
    el('cfg_schedule_start').value = scheduler.hora_inicio || '09:15';
    el('cfg_schedule_end').value = scheduler.hora_fin || '15:45';
    updateSizingMode();
    updateScheduleMode();
  } catch(e){}
}

async function saveRiskConfig(){
  const mode = el('cfg_sizing_mode').value;
  const fixedShares = Math.max(1, parseInt(el('cfg_fixed_shares').value || '1', 10));
  const riskPct = parseFloat(el('cfg_risk_pct').value || '1');
  const stopFactor = Number(el('cfg_stop_loss_factor').value || 35)/10;
  const takeFactor = Number(el('cfg_take_profit_factor').value || 45)/10;
  const perTicker = !!(S.tickerExecutionMeta || {}).per_ticker_execution;
  if(takeFactor<=stopFactor){
    toast('err','Configuración inválida','Take Profit ATR debe ser mayor que Stop Loss ATR');
    return;
  }
  const confirmText = perTicker
    ? `Guardar SL ${stopFactor.toFixed(1)}×ATR y TP ${takeFactor.toFixed(1)}×ATR?\n\nLas acciones se gestionan por ticker en el Dashboard.`
    : `Guardar SL ${stopFactor.toFixed(1)}×ATR, TP ${takeFactor.toFixed(1)}×ATR y ${fixedShares} acciones?\n\nSe aplicará solo a operaciones nuevas después de reiniciar el motor.`;
  if(!confirm(confirmText)) return;
  const riskPayload = {
    stop_loss_factor: stopFactor,
    take_profit_factor: takeFactor
  };
  if(!perTicker){
    riskPayload.sizing_mode = mode;
    riskPayload.fixed_shares = fixedShares;
    riskPayload.risk_per_trade_pct = riskPct;
  }
  try {
    const r = await api('/api/config',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({risk:riskPayload})
    });
    const d = await r.json();
    if(d.status === 'ok'){
      toast('ok','Riesgo guardado',perTicker ? 'SL/TP guardados; las acciones siguen por ticker' : 'SL/TP y cantidad se aplicarán a operaciones nuevas tras reiniciar el motor');
      fetchConfig();
    } else {
      toast('err','Error',d.message || 'No se pudo guardar');
    }
  } catch(e){ toast('err','Error','No se pudo guardar la cantidad'); }
}

function updateScheduleMode(){
  const automatico = el('cfg_schedule_mode').value === 'automatico';
  el('cfg_schedule_times').style.opacity = automatico ? '1' : '.55';
}

async function saveScheduleConfig(){
  const modo = el('cfg_schedule_mode').value;
  const horaInicio = el('cfg_schedule_start').value || '09:15';
  const horaFin = el('cfg_schedule_end').value || '15:45';
  if(horaInicio >= horaFin){
    toast('err','Horario inválido','La hora de inicio debe ser anterior al apagado');
    return;
  }
  if(
    modo === 'automatico'
    && !confirm(
      'El motor PAPER se encenderá y apagará automáticamente en horario ET. ¿Guardar?'
    )
  ) return;
  try {
    const r = await api('/api/config',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({scheduler:{
        modo: modo,
        hora_inicio: horaInicio,
        hora_fin: horaFin,
        zona_horaria: 'America/New_York',
        automatico_solo_paper: true
      }})
    });
    const d = await r.json();
    if(d.status === 'ok'){
      toast(
        'ok',
        'Control horario guardado',
        modo === 'automatico'
          ? `PAPER automático ${horaInicio}–${horaFin} ET`
          : 'El encendido vuelve a ser manual'
      );
      fetchConfig();
      fetchStatus();
    } else {
      toast('err','Error',d.message || 'No se pudo guardar el horario');
    }
  } catch(e){ toast('err','Error','No se pudo guardar el control horario'); }
}

// ─────────────────────────────────────────────────────────
// TOAST
// ─────────────────────────────────────────────────────────
function toast(type, title, msg){
  const box = el('toastBox');
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<span class="toast-icon"></span><div><div class="toast-title">${escHtml(title)}</div><div class="toast-msg">${escHtml(msg)}</div></div>`;
  box.appendChild(t);
  setTimeout(() => { t.style.transition='opacity .3s'; t.style.opacity='0'; setTimeout(()=>t.remove(),300); }, 3500);
}

// ─────────────────────────────────────────────────────────
// UTILS
// ─────────────────────────────────────────────────────────
function el(id){ return document.getElementById(id); }
function escHtml(s){ return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

