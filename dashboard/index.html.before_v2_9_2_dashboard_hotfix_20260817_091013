  el('dailyRiskLimit').textContent = money(limit);
  el('dailyRiskRoom').textContent = money(room);
  el('dailyRiskState').textContent = blocked
    ? '⛔ BLOQUEADO POR PÉRDIDA DIARIA'
    : (enabled ? '🛡️ Kill Switch diario preparado' : '⚠️ Kill Switch diario desactivado');
  const realized = Number(risk.realized_pnl || 0);
  const unrealized = Number(risk.unrealized_pnl || 0);
  el('dailyRiskDetail').textContent = blocked
    ? `Sin nuevas entradas hasta la próxima sesión NY · ${risk.reason || ''}`
    : `${risk.mode || 'PAPER'} · Realizado ${money(realized)} · No realizado ${money(unrealized)}`;
