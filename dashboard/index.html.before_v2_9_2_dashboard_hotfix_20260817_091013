const chartPointers=new Map();
let chartDragState=null;
let chartPinchState=null;
let chartInteractionsReady=false;

function hideSignalChartCrosshair(){
  const group=el('signalChartCrosshair');
  if(group) group.setAttribute('visibility','hidden');
}

function updateSignalChartCrosshair(event){
  const svg=el('signalChartSvg');
  const geometry=S.chartGeometry;
  if(!svg||!geometry) return;
  const rect=svg.getBoundingClientRect();
  if(!rect.width||!rect.height) return;
  const vx=(event.clientX-rect.left)/rect.width*geometry.W;
  const vy=(event.clientY-rect.top)/rect.height*geometry.H;
  if(vx<geometry.L||vx>geometry.W-geometry.R||vy<geometry.T||vy>geometry.H-geometry.B){
    hideSignalChartCrosshair();
    return;
  }
  const epoch=geometry.minT+(vx-geometry.L)/geometry.plotW*(geometry.maxT-geometry.minT);
  const price=geometry.maxP-(vy-geometry.T)/geometry.plotH*(geometry.maxP-geometry.minP);
  const group=el('signalChartCrosshair');
  if(!group) return;
  group.setAttribute('visibility','visible');
  const vLine=el('crosshairVertical'),hLine=el('crosshairHorizontal');
  vLine?.setAttribute('x1',vx.toFixed(1));vLine?.setAttribute('x2',vx.toFixed(1));
  hLine?.setAttribute('y1',vy.toFixed(1));hLine?.setAttribute('y2',vy.toFixed(1));
  const priceBox=el('crosshairPriceBox'),priceText=el('crosshairPriceText');
  priceBox?.setAttribute('y',(vy-10).toFixed(1));
  priceText?.setAttribute('y',(vy+4).toFixed(1));
  if(priceText) priceText.textContent='$'+price.toFixed(2);
  const timeWidth=76,timeX=Math.max(geometry.L,Math.min(geometry.W-geometry.R-timeWidth,vx-timeWidth/2));
  const timeBox=el('crosshairTimeBox'),timeText=el('crosshairTimeText');
  timeBox?.setAttribute('x',timeX.toFixed(1));
  timeText?.setAttribute('x',(timeX+timeWidth/2).toFixed(1));
  if(timeText) timeText.textContent=new Date(epoch).toLocaleTimeString('es-ES',{
    hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'America/New_York'
  });
}

function ensureSignalChartInteractions(){
  if(chartInteractionsReady) return;
  const wrap=el('signalChartWrap');
  if(!wrap) return;
  chartInteractionsReady=true;
  wrap.addEventListener('wheel',event=>{
    if(!S.chartData) return;
    event.preventDefault();
    const rect=wrap.getBoundingClientRect();
    const pivot=(event.clientX-rect.left)/Math.max(1,rect.width);
    zoomSignalChart(event.deltaY<0?.82:1.22,pivot);
  },{passive:false});
  wrap.addEventListener('pointerdown',event=>{
    if(!S.chartData) return;
    chartPointers.set(event.pointerId,event.clientX);
    wrap.setPointerCapture?.(event.pointerId);
    wrap.classList.add('dragging');
    if(chartPointers.size===1){
      chartDragState={x:event.clientX,start:S.chartViewportStart,end:S.chartViewportEnd};
    }else if(chartPointers.size===2){
      const xs=[...chartPointers.values()];
      chartPinchState={distance:Math.max(1,Math.abs(xs[1]-xs[0])),start:S.chartViewportStart,end:S.chartViewportEnd};
    }
  });
  wrap.addEventListener('pointermove',event=>{
    updateSignalChartCrosshair(event);
    if(!chartPointers.has(event.pointerId) || !S.chartData) return;
    chartPointers.set(event.pointerId,event.clientX);
    const width=Math.max(1,wrap.getBoundingClientRect().width);
    if(chartPointers.size>=2 && chartPinchState){
      const xs=[...chartPointers.values()];
      const distance=Math.max(1,Math.abs(xs[1]-xs[0]));
      const baseSpan=chartPinchState.end-chartPinchState.start;
      const factor=chartPinchState.distance/distance;
      const center=(chartPinchState.start+chartPinchState.end)/2;
      const clamped=clampChartViewport(center-baseSpan*factor/2,center+baseSpan*factor/2);
      S.chartViewportStart=clamped.start;
      S.chartViewportEnd=clamped.end;
    }else if(chartDragState){
      const span=chartDragState.end-chartDragState.start;
      const shift=-(event.clientX-chartDragState.x)/width*span;
      const clamped=clampChartViewport(chartDragState.start+shift,chartDragState.end+shift);
      S.chartViewportStart=clamped.start;
      S.chartViewportEnd=clamped.end;
    }
    S.chartFullSession=false;
    S.chartAutoFollow=false;
    updateChartControls();
    drawSignalChart();
  });
  const finishPointer=event=>{
    chartPointers.delete(event.pointerId);
    if(chartPointers.size<2) chartPinchState=null;
    if(chartPointers.size===0){chartDragState=null;wrap.classList.remove('dragging');}
  };
  wrap.addEventListener('pointerup',finishPointer);
  wrap.addEventListener('pointercancel',finishPointer);
  wrap.addEventListener('pointerleave',hideSignalChartCrosshair);
  wrap.addEventListener('dblclick',()=>resetSignalChartViewport());
}

async function fetchSignalChart(options={}){
  if(!S.selectedTicker) return;
  const silent=Boolean(options.silent);
  const preserveViewport=Boolean(options.preserveViewport);
  const requestSerial=++S.chartRequestSerial;
  S.chartFetchInFlight=true;
  const wrap=el('signalChartWrap');
  const dateInput=el('signalChartDate');
  if(dateInput && S.selectedDate) dateInput.value=S.selectedDate;
  updateChartControls();
  if(!silent){
    el('signalChartTitle').textContent=`${S.selectedTicker} · cargando…`;
    el('signalChartMeta').textContent=S.chartMode==='live'
      ? 'Sincronizando velas de un minuto con Schwab'
      : 'Cargando la sesión de Nueva York y sus señales guardadas';
    wrap.innerHTML='<div class="empty-state"><div class="es-icon">⏳</div><div>Cargando gráfico de Schwab…</div></div>';
  }
  const params=new URLSearchParams({ticker:S.selectedTicker,window:String(S.chartWindow)});
  if(S.selectedSignalId) params.set('signal_id',S.selectedSignalId);
  if(S.selectedDate) params.set('date',S.selectedDate);
  params.set('view',S.chartMode==='live'?'live':'session');
  try{
    const r=await api('/api/signals/chart?'+params.toString());
    const d=await r.json();
    if(!r.ok || d.status!=='ok') throw new Error(d.message||'No se pudo cargar el gráfico');
    if(requestSerial!==S.chartRequestSerial) return;
    renderSignalChart(d,{preserveViewport});
  }catch(e){
    if(requestSerial!==S.chartRequestSerial) return;
    if(silent && S.chartData){
      const badge=el('signalChartLiveStatus');
      if(badge){badge.textContent='ACTUALIZACIÓN EN PAUSA';badge.className='chart-live-badge stale';}
      return;
    }
    el('signalChartTitle').textContent=`${S.selectedTicker} · gráfico no disponible`;
    el('signalChartMeta').textContent=String(e.message||e);
    wrap.innerHTML=`<div class="empty-state"><div class="es-icon">⚠️</div><div>${escHtml(e.message||e)}</div></div>`;
  }finally{
    if(requestSerial===S.chartRequestSerial) S.chartFetchInFlight=false;
  }
}

function renderSignalChart(data,options={}){
  const candles=data.candles||[];
  if(candles.length<2) throw new Error('No hay suficientes velas para dibujar el gráfico');
  const oldStart=S.chartViewportStart, oldEnd=S.chartViewportEnd;
  S.chartData=data;
  S.selectedDate=String(data.selected_date||S.selectedDate||'');
  const dateInput=el('signalChartDate');
  if(dateInput && S.selectedDate) dateInput.value=S.selectedDate;
  const bounds=chartSessionBounds(data);
  if(!bounds) throw new Error('El rango horario del gráfico no es válido');
  if(options.preserveViewport && Number.isFinite(oldStart) && Number.isFinite(oldEnd)){
    if(S.chartMode==='live' && S.chartAutoFollow && !S.chartFullSession){
      const last=Number(candles[candles.length-1].epoch_ms);
      const span=oldEnd-oldStart;
      const clamped=clampChartViewport(last-span,last);
      S.chartViewportStart=clamped.start;
      S.chartViewportEnd=clamped.end;
    }else{
      const clamped=clampChartViewport(oldStart,oldEnd);
      S.chartViewportStart=clamped.start;
      S.chartViewportEnd=clamped.end;
    }
  }else if(S.chartFullSession || (S.chartMode==='session' && !data.selected_signal)){
    S.chartViewportStart=bounds.start;
    S.chartViewportEnd=bounds.end;
    S.chartFullSession=true;
  }else{
    const span=Math.max(5,Number(S.chartWindow||60))*60000;
    const selected=data.selected_signal;
    const selectedEpoch=selected && Number(selected.epoch_ms||Date.parse(selected.timestamp_iso||''));
    if(Number.isFinite(selectedEpoch)){
      const clamped=clampChartViewport(selectedEpoch-span/2,selectedEpoch+span/2);
      S.chartViewportStart=clamped.start;
      S.chartViewportEnd=clamped.end;
    }else{
      const last=Number(candles[candles.length-1].epoch_ms);
      const clamped=clampChartViewport(last-span,last);
      S.chartViewportStart=clamped.start;
      S.chartViewportEnd=clamped.end;
    }
  }
  updateChartControls();
  ensureSignalChartInteractions();
  drawSignalChart();
}

function drawSignalChart(){
  const data=S.chartData;
  if(!data) return;
  const allCandles=data.candles||[];
  const allMarkers=data.signals||[];
  const active=data.active_position||null;
  const allTradeEvents=[...(data.trade_events||[])];
  if(active&&active.partial_exit_at&&Number(active.partial_exit_price)>0&&!allTradeEvents.some(e=>e.kind==='PARTIAL_70')){
    allTradeEvents.push({
      kind:'PARTIAL_70',label:'SALIDA 70%',price:Number(active.partial_exit_price),
      epoch_ms:Date.parse(active.partial_exit_at),quantity:Number(active.partial_quantity_executed||0),
      pnl_usd:Number(active.realized_pnl||0)
    });
  }
  const selected=data.selected_signal||null;
  const minT=Number(S.chartViewportStart), maxT=Number(S.chartViewportEnd);
  if(!Number.isFinite(minT)||!Number.isFinite(maxT)||maxT<=minT) return;
  const candles=allCandles.filter(c=>Number(c.epoch_ms)>=minT&&Number(c.epoch_ms)<=maxT);
  const markers=allMarkers.filter(s=>{
    const epoch=Number(s.epoch_ms||Date.parse(s.timestamp_iso||''));
    return Number.isFinite(epoch)&&epoch>=minT&&epoch<=maxT;
  });
  const tradeEvents=allTradeEvents.filter(event=>{
    const epoch=Number(event.epoch_ms||Date.parse(event.timestamp_iso||''));
    return Number.isFinite(epoch)&&epoch>=minT&&epoch<=maxT;
  });
  const scaleCandles=candles.length?candles:allCandles.slice(-1);
  const markerPrices=markers.map(s=>Number(s.precio)).filter(Number.isFinite);
  const eventPrices=tradeEvents.map(event=>Number(event.price)).filter(Number.isFinite);
  const positionPrices=active?[
    active.entry_price,active.stop_current,active.tp1_hit?null:active.tp1_price,active.final_target
  ].map(Number).filter(value=>Number.isFinite(value)&&value>0):[];
  const lows=scaleCandles.map(c=>Number(c.low)).filter(Number.isFinite);
  const highs=scaleCandles.map(c=>Number(c.high)).filter(Number.isFinite);
  let minP=Math.min(...lows,...markerPrices,...eventPrices,...positionPrices),maxP=Math.max(...highs,...markerPrices,...eventPrices,...positionPrices);
  if(!Number.isFinite(minP)||!Number.isFinite(maxP)){minP=0;maxP=1;}
  const pad=Math.max((maxP-minP)*.08,Math.abs(maxP||1)*.0005,.01);
  minP-=pad;maxP+=pad;
  const W=1000,H=360,L=64,R=22,T=22,B=48,plotW=W-L-R,plotH=H-T-B;
  const x=t=>L+((Number(t)-minT)/Math.max(1,maxT-minT))*plotW;
  const y=p=>T+(1-(Number(p)-minP)/Math.max(.000001,maxP-minP))*plotH;
  const grid=[];
  for(let i=0;i<=4;i++){
    const gy=T+plotH*i/4,price=maxP-(maxP-minP)*i/4;
    grid.push(`<line x1="${L}" y1="${gy}" x2="${W-R}" y2="${gy}" stroke="var(--border)" stroke-width="1"/>`);
    grid.push(`<text x="${L-8}" y="${gy+4}" fill="var(--txt3)" text-anchor="end" font-size="11" font-family="monospace">$${price.toFixed(2)}</text>`);
  }
  const spanMinutes=(maxT-minT)/60000;
  const tickMinutes=spanMinutes<=15?1:spanMinutes<=30?5:spanMinutes<=60?10:spanMinutes<=120?15:spanMinutes<=240?30:60;
  const tickMs=tickMinutes*60000;
  const firstTick=Math.ceil(minT/tickMs)*tickMs;
  for(let epoch=firstTick,count=0;epoch<=maxT&&count<24;epoch+=tickMs,count++){
    const tx=x(epoch);
    const label=new Date(epoch).toLocaleTimeString('es-ES',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'America/New_York'});
    grid.push(`<line x1="${tx}" y1="${T}" x2="${tx}" y2="${H-B}" stroke="var(--border)" stroke-width="1" opacity=".55"/>`);
    grid.push(`<text x="${tx}" y="${H-20}" fill="var(--txt3)" text-anchor="middle" font-size="11" font-family="monospace">${label}</text>`);
  }
  const oneMinuteWidth=plotW/Math.max(1,(maxT-minT)/60000);
  const candleWidth=Math.max(1.2,Math.min(18,oneMinuteWidth*.68));
  const lastClosed=Number(data.last_closed_epoch_ms||0);
  const candleSvg=candles.map(c=>{
    const cx=x(c.epoch_ms);
    const open=Number(c.open),high=Number(c.high),low=Number(c.low),close=Number(c.close);
    const yOpen=y(open),yHigh=y(high),yLow=y(low),yClose=y(close);
    const rising=close>=open,color=rising?'var(--green)':'var(--red)';
    const bodyY=Math.min(yOpen,yClose),bodyHeight=Math.max(1.4,Math.abs(yClose-yOpen));
    const timestamp=String(c.timestamp_iso||'');
    const timeLabel=timestamp?new Date(timestamp).toLocaleString('es-ES',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'America/New_York'}):'';
    const tooltip=`${timeLabel} NY · O ${open.toFixed(2)} · H ${high.toFixed(2)} · L ${low.toFixed(2)} · C ${close.toFixed(2)} · Vol ${Number(c.volume||0).toLocaleString('es-ES')}`;
    const forming=data.live&&Number(c.epoch_ms)>lastClosed;
    return `<g class="price-candle ${rising?'bullish':'bearish'}${forming?' forming':''}" opacity="${forming?'.78':'1'}">
      <title>${escHtml(tooltip)}${forming?' · vela en formación':''}</title>
      <line x1="${cx.toFixed(1)}" y1="${yHigh.toFixed(1)}" x2="${cx.toFixed(1)}" y2="${yLow.toFixed(1)}" stroke="${color}" stroke-width="1.4"/>
      <rect x="${(cx-candleWidth/2).toFixed(1)}" y="${bodyY.toFixed(1)}" width="${candleWidth.toFixed(1)}" height="${bodyHeight.toFixed(1)}" fill="${color}" stroke="${color}" stroke-width=".8" rx=".4"/>
    </g>`;
  }).join('');
  const signalSvg=markers.map(s=>{
    const epoch=Number(s.epoch_ms||Date.parse(s.timestamp_iso||''));
    const sx=x(epoch),sy=y(Number(s.precio)),tipo=String(s.tipo||'').toUpperCase();
    const color=tipo==='BUY'?'var(--green)':tipo==='SELL'?'var(--red)':'var(--txt3)';
    const selectedRing=selected&&s.signal_id===selected.signal_id?`<circle cx="${sx}" cy="${sy}" r="13" fill="none" stroke="var(--orange)" stroke-width="2"/>`:'';
    let shape=`<circle cx="${sx}" cy="${sy}" r="6" fill="${color}" stroke="var(--bg2)" stroke-width="2"/>`;
    if(tipo==='BUY') shape=`<polygon points="${sx},${sy-8} ${sx-7},${sy+6} ${sx+7},${sy+6}" fill="${color}" stroke="var(--bg2)" stroke-width="2"/>`;
    if(tipo==='SELL') shape=`<polygon points="${sx},${sy+8} ${sx-7},${sy-6} ${sx+7},${sy-6}" fill="${color}" stroke="var(--bg2)" stroke-width="2"/>`;
    return `${selectedRing}${shape}<text x="${sx}" y="${tipo==='SELL'?sy+23:sy-14}" fill="${color}" text-anchor="middle" font-size="10" font-weight="700">${escHtml(tipo)}</text>`;
  }).join('');
  const tradeEventSvg=tradeEvents.map(event=>{
    const epoch=Number(event.epoch_ms||Date.parse(event.timestamp_iso||''));
    const ex=x(epoch),ey=y(Number(event.price)),kind=String(event.kind||'');
    const color=kind==='ENTRY'?'#60a5fa':kind==='PARTIAL_70'?'#22d3ee':'#f8fafc';
    let shape=`<circle cx="${ex}" cy="${ey}" r="6" fill="${color}" stroke="var(--bg2)" stroke-width="2"/>`;
    if(kind==='PARTIAL_70') shape=`<polygon points="${ex},${ey-8} ${ex+8},${ey} ${ex},${ey+8} ${ex-8},${ey}" fill="${color}" stroke="var(--bg2)" stroke-width="2"/>`;
    if(kind==='ENTRY') shape=`<rect x="${ex-5}" y="${ey-5}" width="10" height="10" rx="2" fill="${color}" stroke="var(--bg2)" stroke-width="2"/>`;
    const detail=`${event.label||kind} · ${Number(event.quantity||0)} acc · $${Number(event.price||0).toFixed(2)} · P&L $${Number(event.pnl_usd||0).toFixed(2)}`;
    return `<g><title>${escHtml(detail)}</title>${shape}<text x="${ex}" y="${ey-13}" fill="${color}" text-anchor="middle" font-size="9" font-weight="800">${escHtml(event.label||kind)}</text></g>`;
  }).join('');
  const positionLine=(price,color,label,dash='6 4')=>{
    const value=Number(price||0);
    if(!active||!Number.isFinite(value)||value<=0) return '';
    const opened=Date.parse(active.opened_at||'');
    const startX=Number.isFinite(opened)?Math.max(L,Math.min(W-R,x(opened))):L;
    const py=y(value);
    return `<g><line x1="${startX}" y1="${py}" x2="${W-R}" y2="${py}" stroke="${color}" stroke-width="1.7" stroke-dasharray="${dash}"/><text x="${W-R-5}" y="${py-4}" fill="${color}" text-anchor="end" font-size="10" font-weight="800">${label} $${value.toFixed(2)}</text></g>`;
  };
  const positionSvg=active?[
    positionLine(active.entry_price,'#60a5fa','ENTRADA',''),
    positionLine(active.stop_current,'#f59e0b',active.breakeven_active?'SL · BE':'SL'),
    active.tp1_hit?'':positionLine(active.tp1_price,'#22d3ee','TP1 · 70%','3 4'),
    positionLine(active.final_target,'#a78bfa','TP FINAL')
  ].join(''):'';
  const floating=Number(active?.floating_pnl||0);
  const pnlColor=floating>=0?'var(--green)':'var(--red)';
  const pnlSign=floating>0?'+':'';
  const positionPnlSvg=active?`<g>
    <rect x="${W-R-246}" y="${T+7}" width="238" height="29" rx="7" fill="var(--bg3)" stroke="${pnlColor}" stroke-width="1" opacity=".96"/>
    <text x="${W-R-127}" y="${T+26}" fill="${pnlColor}" text-anchor="middle" font-size="12" font-weight="800">P&amp;L flotante ${pnlSign}$${floating.toFixed(2)} · ${Number(active.remaining_quantity||0)}/${Number(active.initial_quantity||0)} acc</text>
  </g>`:'';
  const selectedTime=selected?[selected.date,selected.timestamp].filter(Boolean).join(' '):`${data.selected_date||S.selectedDate} · sesión 09:15–15:45`;
  const sourceLabels={local_archive:'LOCAL ARCHIVADO',historico_csv:'CSV LOCAL',schwab:'SCHWAB',schwab_live:'SCHWAB EN VIVO',local:'LOCAL'};
  const sourceLabel=sourceLabels[String(data.source||'').toLowerCase()]||String(data.source||'local').toUpperCase();
  const fromLabel=new Date(minT).toLocaleTimeString('es-ES',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'America/New_York'});
  const toLabel=new Date(maxT).toLocaleTimeString('es-ES',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'America/New_York'});
  el('signalChartTitle').textContent=`${data.ticker} · ${selected?selected.tipo+' @ $'+Number(selected.precio||0).toFixed(2):active?'posición '+String(active.side||'')+' activa':S.chartMode==='live'?'precio en vivo':'precio histórico'}`;
  const positionMeta=active?` · Entrada $${Number(active.entry_price||0).toFixed(2)} · P&L flotante ${pnlSign}$${floating.toFixed(2)}`:'';
  el('signalChartMeta').textContent=`${selectedTime} NY · ${fromLabel}–${toLabel} · ${candles.length}/${allCandles.length} velas japonesas 1m · fuente ${sourceLabel}${positionMeta}`;
  const liveBadge=el('signalChartLiveStatus');
  if(liveBadge){
    liveBadge.textContent=data.live?(data.live_status==='connected'?'● EN VIVO · 5s':'● DATOS LOCALES') : '';
    liveBadge.className='chart-live-badge'+(data.live&&data.live_status!=='connected'?' stale':'');
  }
  const emptyOverlay=candles.length?'':`<text x="${W/2}" y="${H/2}" fill="var(--txt3)" text-anchor="middle" font-size="14">Sin velas en este rango; arrastra o restablece el zoom</text>`;
  S.chartGeometry={W,H,L,R,T,B,plotW,plotH,minT,maxT,minP,maxP};
  el('signalChartWrap').innerHTML=`<svg id="signalChartSvg" viewBox="0 0 ${W} ${H}" role="img" aria-label="Velas japonesas y señales históricas o en vivo de ${escHtml(data.ticker)} con zoom interactivo">
    <rect x="${L}" y="${T}" width="${plotW}" height="${plotH}" fill="transparent"/>
    ${grid.join('')}${candleSvg}${positionSvg}${signalSvg}${tradeEventSvg}${positionPnlSvg}${emptyOverlay}
    <g id="signalChartCrosshair" visibility="hidden" pointer-events="none">
      <line id="crosshairVertical" y1="${T}" y2="${H-B}" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="4 4" opacity=".9"/>
      <line id="crosshairHorizontal" x1="${L}" x2="${W-R}" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="4 4" opacity=".9"/>
      <rect id="crosshairPriceBox" x="0" width="${L-4}" height="20" rx="3" fill="#e2e8f0"/>
      <text id="crosshairPriceText" x="${L-8}" fill="#0f172a" text-anchor="end" font-size="11" font-family="monospace" font-weight="800"></text>
      <rect id="crosshairTimeBox" y="${H-B+2}" width="76" height="22" rx="3" fill="#e2e8f0"/>
      <text id="crosshairTimeText" y="${H-B+17}" fill="#0f172a" text-anchor="middle" font-size="11" font-family="monospace" font-weight="800"></text>
    </g>
  </svg>`;
}

