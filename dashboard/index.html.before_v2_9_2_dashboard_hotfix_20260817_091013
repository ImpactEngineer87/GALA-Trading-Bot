const S = {
  tickers: ['BA','AAPL','TSLA','NVDA','AMD'],
  signals: [],
  positions: [],
  tradeEvents: [],
  trades: [], // compatibility alias
  aiStatus: [],
  tickerExecution: [],
  tickerExecutionMeta: {},
  botRunning: false,
  selectedTicker: '',
  selectedSignalId: '',
  selectedDate: '',
  chartMode: 'signal',
  chartWindow: 60,
  chartData: null,
  chartViewportStart: null,
  chartViewportEnd: null,
  chartAutoFollow: false,
  chartFullSession: false,
  chartFetchInFlight: false,
  chartRequestSerial: 0,
  chartGeometry: null,
};
let csrfToken = '';
const SCHWAB_AUTH_ALERT_INTERVAL_MS = 5 * 60 * 1000;
const SCHWAB_AUTH_ALERT_STORAGE_KEY = 'gala10_schwab_auth_expired_alert_at';
let lastSchwabAuthAlertAt = 0;

// ─────────────────────────────────────────────────────────
// CLOCK
// ─────────────────────────────────────────────────────────
setInterval(() => {
  // Hora del MERCADO (Nueva York), no la del navegador de quien mira el panel.
  // Se fuerza la zona horaria para que TODOS (operador y cliente, estén donde
  // estén) vean la misma hora que el mercado y el broker.
  document.getElementById('clockEl').textContent =
    new Date().toLocaleTimeString('es-ES',{hour12:false,timeZone:'America/New_York'}) + ' NY';
}, 1000);

// ─────────────────────────────────────────────────────────
// SIDEBAR TOGGLE
// ─────────────────────────────────────────────────────────
function toggleSidebar(){
  document.getElementById('mainSidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('open');
}
function closeSidebar(){
  document.getElementById('mainSidebar').classList.remove('open');
  document.getElementById('sidebarOverlay').classList.remove('open');
}

// ─────────────────────────────────────────────────────────
// NAVIGATION
// ─────────────────────────────────────────────────────────
function showPage(id, navBtn, sideBtn, bnavBtn) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-'+id)?.classList.add('active');
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  if(navBtn) navBtn.classList.add('active');
  else {
    const t = document.getElementById('tab-'+id);
    if(t) t.classList.add('active');
  }
  document.querySelectorAll('.sidebar-item').forEach(s => s.classList.remove('active'));
  if(sideBtn) sideBtn.classList.add('active');
  document.querySelectorAll('.bnav-item').forEach(b => b.classList.remove('active'));
  if(bnavBtn) bnavBtn.classList.add('active');
  if(id === 'historial') {
    fetchHistorial();
    fetchAuditoriaOrdenes();
